# Copy to .env and fill in (Supabase dashboard → Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
# The anon / publishable key (safe to ship in the app).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY= goes in .env.local ONLY (service_role / secret key).
# It is used only by scripts/rls-test.ts and must never reach app code or git.
